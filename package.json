{
  "name": "dsh-plugin-subagent-director",
  "version": "0.4.0",
  "description": "Subagent Director: choose an LLM provider/model for each subagent (call args > role binding > plugin default > inherit parent) and plan main-agent/subagent responsibilities with role templates, plus a settings UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeverusZh/dsh-plugin-subagent-director.git"
  },
  "homepage": "https://github.com/SeverusZh/dsh-plugin-subagent-director",
  "bugs": {
    "url": "https://github.com/SeverusZh/dsh-plugin-subagent-director/issues"
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json",
    "./bridge": {
      "types": "./lib/bridge-entry.d.ts",
      "default": "./lib/bridge-entry.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale",
        "connection",
        "remote"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "subagent",
    "subagent-director",
    "llm",
    "provider",
    "model",
    "role-template"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-scope": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "rolldown": "^1.2.4",
    "typescript": "^7.0.2",
    "use-sync-external-store": "^1.2.0",
    "vitest": "^4.1.10",
    "@deepseek-ai/dsh-util-time": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-attachment": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-brand": "^0.1.2-alpha.4"
  }
}
